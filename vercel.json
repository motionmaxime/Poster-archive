{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {"api/admin.js": {"includeFiles": "admin.html"}},
  "rewrites": [
    {"source": "/admin", "destination": "/api/admin"},
    {"source": "/admin/", "destination": "/api/admin"},
    {"source": "/admin.html", "destination": "/api/admin"}
  ],
  "headers": [{"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "same-origin"}]}]
}
